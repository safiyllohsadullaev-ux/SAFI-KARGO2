# SAFI KARGO — нусхаи муҳит. Ин файлро ба .env нусха кунед.
# Ҳеҷ гоҳ .env-ро нашр накунед.

# sqlite барои оғози маҳаллӣ. Барои PostgreSQL ва Vercel/Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Агар суроға -pooler дошта бошад, ҳамонро барои API истифода баред.
DATABASE_URL=sqlite:///./data/safi.db

# Калиди дароз ва тасодуфӣ. Дар production иваз кунед.
JWT_SECRET=change-this-to-a-long-random-secret

# Администратори аввалия. Рақам ва рамзро иваз кунед.
ADMIN_PHONE=+992000000000
ADMIN_PASSWORD=ChangeMe_Admin_2026
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# SMS. Агар холӣ бошад, SMS фиристода намешавад.
# SMS_WEBHOOK_URL=https://example.com/sms
SMS_WEBHOOK_URL=

# ТАНҲО барои кори маҳаллӣ: рамзи OTP дар ҷавоб нишон дода мешавад.
# Дар production ҳатман false гузоред.
DEV_OTP_REVEAL=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Дар Vercel домени сомонаро ҳам гузоред, масалан https://safi-kargo.vercel.app
# FRONTEND_URL=https://safi-kargo.vercel.app
COMPANY_TZ=Asia/Dushanbe
STORAGE_DIR=./storage
# disk — файлҳо дар диск (маҳаллӣ). database — файлҳо дар Postgres (Vercel худ инро интихоб мекунад).
# STORAGE_BACKEND=disk
